<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Trimming</title>
  <link rel="icon" href="favicon.ico" />
  <link rel="stylesheet" href="styles.css">
</head>

<body>
  <div>
    <header class="header">
      <a href="https://www.instagram.com/kikkawarei/" target="_blank"><span class="link-text">Instagram</span></a>
    </header>
    {% for post in collections.posts %}
    <div class="item">
      <img src="{{ post.data.image }}" alt="{{ post.data.title }}">
      <div class="text">
        <div class="yearWrapper">
          {% if post.data.year and post.data.year != "" %}
          <div class="year">{{ post.data.year }}</div>
          {% endif %}
          {% if post.data.date_display and post.data.date_display != "" %}
          <div class="date">{{ post.data.date_display }}</div>
          {% endif %}
        </div>
      </div>
    </div>
    {% endfor %}
  </div>

  <div class="page-indicator">
    <span id="current-page">1</span>
  </div>

  <div class="progress">
    <div class="progress-bar"></div>
  </div>


  <div id="container"></div>
  <script type="module" src="js/app.js"></script>
</body>

</html>