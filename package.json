{
  "name": "eleventy-blog-mnml",
  "version": "1.0.0",
  "description": "A Blog Template using eleventy and terminal css.",
  "scripts": {
    "build": "eleventy && parcel build _site/index.html --dist-dir dist --public-url ./",
    "dev": "npm run clean && eleventy && concurrently \"eleventy --watch\" \"parcel _site/index.html --no-cache\"",
    "clean": "rm -rf _site dist .parcel-cache"
  },
  "keywords": [],
  "author": "Arpit Batra (arpitbatra123@gmail.com)",
  "license": "MIT",
  "dependencies": {
    "@11ty/eleventy": "^0.12.1",
    "@11ty/eleventy-plugin-rss": "^1.1.1",
    "@11ty/eleventy-plugin-syntaxhighlight": "^3.1.2",
    "@parcel/transformer-glsl": "^2.16.3",
    "concurrently": "^6.2.2",
    "dat.gui": "^0.7.9",
    "gsap": "^3.14.2",
    "parcel": "^2.16.3",
    "sass": "^1.42.1",
    "three": "^0.182.0"
  }
}